# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# Local scratch files
tmp/

# JavaScript / Expo generated project files
node_modules/
package-lock.json
.npm-cache/
.expo-home/
.expo/
dist/
.test-build/
.test-build-codex/
.test-build-*/
.codex-test-build-*/

# Mobile pilot local transcription models
apps/mobile/assets/models/*.bin
apps/mobile/assets/fonts/*.ttf
apps/mobile/assets/fonts/*.otf
apps/mobile/models/*.bin
apps/mobile/.models/
apps/mobile/.transcription-models/

# Mobile generated dependencies and native build artifacts
apps/mobile/node_modules/
apps/mobile/.npm-cache/
apps/mobile/.expo-home/
apps/mobile/.expo/
apps/mobile/dist/
apps/mobile/.test-build/
apps/mobile/.test-build-codex/
apps/mobile/.test-build-*/
apps/mobile/.codex-test-build-*/
apps/mobile/android/
apps/mobile/ios/
apps/mobile/expo-env.d.ts

# Editor/IDE
# .idea/
# .vscode/
